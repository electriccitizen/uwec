#!/bin/bash
set -eo pipefail

# Cut gitignore at the cut mark.
terminus build:gitignore:cut

# Authenticate with Terminus
terminus -n auth:login --machine-token="$TERMINUS_TOKEN"

# Defensive guard: never try to create a multidev called dev/test/live
if [[ "$TERMINUS_ENV" =~ ^(dev|test|live)$ ]]; then
  # Default branch deploy (or any case where we explicitly target a fixed env)
  terminus -n build:env:push "$TERMINUS_SITE.dev" --yes
else
  # Non-default branch (multidev) deploy
  terminus -n build:env:create "$TERMINUS_SITE.dev" "$TERMINUS_ENV" --yes
fi

# Wait for Pantheon to finish applying the code before touching the database.
#
# terminus build:env:push stops waiting on the sync workflow after 180 seconds
# and returns success regardless ("giving up waiting for workflow to finish").
# On a large deploy -- a core minor, for instance -- the environment can still
# be syncing when we reach updatedb, which then fails with "needs a higher
# bootstrap level to run". Under `set -e` that aborts the deploy *after* the
# code has already landed, leaving the environment running new code against an
# un-migrated database. That happened on the 11.3.14 -> 11.4.5 deploy.
#
# Poll the precondition we actually care about rather than guessing a duration.
#
# The bootstrap check alone is not enough. While the sync is still running the
# environment bootstraps fine on the *old* code, so the check passes at once,
# and Pantheon then swaps the code out from under whichever drush command is
# running. That killed updatedb or config-import (exit 137, or a class missing
# from a half-swapped vendor/) on four of the five September 2026 deploys, and
# left Dev without the config those deploys carried. So wait for the sync
# workflow itself to finish first.
echo "Waiting for code sync on $TERMINUS_SITE.$TERMINUS_ENV to finish..."
sync_done=""
for attempt in $(seq 1 60); do
  if workflows="$(terminus -n workflow:list "$TERMINUS_SITE" --format=csv --fields=env,workflow,status 2>/dev/null)" \
      && [ -n "$workflows" ] \
      && ! grep -qE "^$TERMINUS_ENV,.*Sync code.*,running" <<< "$workflows"; then
    echo "Code sync finished after ~$(((attempt - 1) * 10))s."
    sync_done=1
    break
  fi
  sleep 10
done
if [ -z "$sync_done" ]; then
  echo "ERROR: code sync on $TERMINUS_SITE.$TERMINUS_ENV still running after 600s." >&2
  echo "Code may be deployed without database updates -- check before promoting." >&2
  exit 1
fi

echo "Waiting for $TERMINUS_SITE.$TERMINUS_ENV to become bootstrappable..."
bootstrap_ready=""
for attempt in $(seq 1 60); do
  if terminus -n drush "$TERMINUS_SITE.$TERMINUS_ENV" -- status --field=bootstrap 2>/dev/null \
      | grep -qi successful; then
    echo "Environment ready after ~$((attempt * 10))s."
    bootstrap_ready=1
    break
  fi
  sleep 10
done
if [ -z "$bootstrap_ready" ]; then
  echo "ERROR: $TERMINUS_SITE.$TERMINUS_ENV did not bootstrap within 600s." >&2
  echo "Code may be deployed without database updates -- check before promoting." >&2
  exit 1
fi

# Update the Drupal database
terminus -n drush "$TERMINUS_SITE.$TERMINUS_ENV" -- updatedb -y

# If exported configuration is available, then import it.
# The guard path must match $settings['config_sync_directory'] in
# web/sites/default/settings.php, which is ../config/sync on this site.
# The Pantheon build-tools default points one directory higher, where
# this site has nothing, so the guard was false on every deploy and
# config was never imported -- while updatedb and cr on either side
# kept succeeding, which is why it went unnoticed.
if [ -f "config/sync/system.site.yml" ] ; then
  terminus -n drush "$TERMINUS_SITE.$TERMINUS_ENV" -- config-import --yes
fi

# Clear Drupal cache
terminus -n drush "$TERMINUS_SITE.$TERMINUS_ENV" -- cr

# Clear the environment cache
terminus -n env:clear-cache "$TERMINUS_SITE.$TERMINUS_ENV"

# Ensure secrets are set
terminus -n secrets:set "$TERMINUS_SITE.$TERMINUS_ENV" token "$GITHUB_TOKEN" --file='github-secrets.json' --clear --skip-if-empty

# PR cleanup (kept for legacy PR-named envs)
terminus -n build:env:delete:pr "$TERMINUS_SITE" --yes
